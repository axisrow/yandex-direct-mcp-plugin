# Single source of truth for runtime dependency pins (mcp, direct-cli) and the
# yandex-audience-cli floor.
#
# Both bootstrap channels source this file:
#   - hooks/setup.sh                       (Claude Code SessionStart)
#   - plugins/yandex-direct/run-server.sh  (Codex bundle cold start, via
#                                           plugins/yandex-direct/scripts/runtime-pins.env)
#
# MCP_VERSION and DIRECT_CLI_VERSION are exact pins; AUDIENCE_CLI_VERSION is a
# floor (installed as yandex-audience-cli>=${AUDIENCE_CLI_VERSION}): 0.1.1 is
# the first real PyPI release and the minimum verified surface, while the
# 0.1.x line may keep moving.
#
# The plugin version is NOT pinned here: the bootstrap scripts derive it from
# their channel manifest (.claude-plugin/plugin.json or .codex-plugin/plugin.json).
#
# The Codex copy under plugins/yandex-direct/scripts/ must stay byte-identical;
# tests/test_pins_consistency.py guards this.
#
# Editing this file by hand is fine, but prefer:
#   scripts/update-pins.sh MCP_VER DIRECT_CLI_VER AUDIENCE_CLI_VER
#   scripts/update-version.sh PLUGIN_VER            — for the plugin version
#
# Stamp file in $CLAUDE_PLUGIN_DATA:
#   .installed-${PLUGIN_VERSION}-${MCP_VERSION}-${DIRECT_CLI_VERSION}-${AUDIENCE_CLI_VERSION}
# Any of the four changing invalidates the stamp and re-runs bootstrap once.
MCP_VERSION=1.23.3
DIRECT_CLI_VERSION=0.5.7
AUDIENCE_CLI_VERSION=0.1.1
